# ローカル実行用のサンプル。cp .env.example .env して値を埋める。
# .env は絶対にコミットしないこと（.gitignore 済み）。

EP_USER=
EP_PASS=
EP_LOGIN_URL=https://manage.entrypocket.jp/
# clients.json に applicant_url を書くならここは空でよい
EP_APPLICANT_URL=

SPREADSHEET_ID=
# サービスアカウントJSONの「中身」を丸ごと1行で貼る（ローカルでは改行込みでも可）
GOOGLE_SERVICE_ACCOUNT_JSON=

# 1 でヘッドレス、0 でブラウザ表示
HEADLESS=1
# auto / manual（_実行ログ に残る）
EP_TRIGGER=manual
